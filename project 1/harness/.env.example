# Local configuration for the evaluation harness.
#
# Copy this file to harness/.env and edit it locally. The copy is git-ignored.
# Every value can also be supplied as an environment variable, which takes
# precedence over this file. Never commit real keys.

# --- evaluated customer-support system (Person 4) -------------------------
# One model call per item, temperature 0, no tools, no retrieval.
SYSTEM_PROVIDER=ollama
SYSTEM_MODEL=qwen2.5:14b
# SYSTEM_BASE_URL=http://localhost:11434
SYSTEM_PROMPT_VERSION=v1
SYSTEM_MAX_TOKENS=512
SYSTEM_TIMEOUT=300

# Hosted system provider (Groq, vLLM, LM Studio, any OpenAI-compatible gateway):
# SYSTEM_PROVIDER=openai
# SYSTEM_MODEL=openai/gpt-oss-20b
# SYSTEM_BASE_URL=https://api.groq.com/openai/v1
# The value lives in the environment under the name given here; the name is the
# only thing this harness ever writes to results.
# SYSTEM_API_KEY_ENV=GROQ_API_KEY

# --- LLM judge (Person 3) --------------------------------------------------
JUDGE_PROVIDER=ollama
JUDGE_MODEL=qwen3:14b
JUDGE_PROMPT_VERSION=judge_v2
JUDGE_MAX_TOKENS=2048
JUDGE_TIMEOUT=300
# Hosted judge: set JUDGE_PROVIDER=groq and provide the key in the
# environment, e.g.  $env:JUDGE_API_KEY = "..."  (never in this file).
JUDGE_API_KEY=

# --- prices, USD per 1,000,000 tokens -------------------------------------
# Unset means "not configured": cost is reported as null, not as zero. Verify
# these against the provider's current price list before publishing a number.
# SYSTEM_INPUT_PRICE_PER_M=
# SYSTEM_OUTPUT_PRICE_PER_M=
# JUDGE_INPUT_PRICE_PER_M=
# JUDGE_OUTPUT_PRICE_PER_M=

# --- optional local-compute assumption ------------------------------------
# Electricity plus depreciation for the machine running Ollama, in USD/hour.
# This is an assumption, not a tariff.
# HARNESS_LOCAL_COST_PER_HOUR=

# --- volume projection -----------------------------------------------------
# HARNESS_RESULTS_ROOT=results/harness
# HARNESS_CURRENCY=USD
