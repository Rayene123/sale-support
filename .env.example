DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@[POOLER-HOST]:5432/postgres?sslmode=require
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_TIMEOUT=120

# Sentiment benchmark: choose provider presets and model IDs.
PROVIDERS=ollama
# OPENAI_MODEL=your-model-id
# OPENAI_API_KEY=replace-locally
# GROQ_MODEL=openai/gpt-oss-20b
# GROQ_API_KEY=replace-locally
# COMPATIBLE_MODEL=your-served-model
# COMPATIBLE_BASE_URL=http://localhost:1234/v1
# For authenticated compatible APIs use --api-key-env MY_API_KEY.
# MY_API_KEY=replace-locally

# Project 2: Qdrant vector index. Copy the cluster URL and API key from the
# Qdrant Cloud console (or use a local URL such as http://localhost:6333).
# QDRANT_API_KEY is a secret; .env is git-ignored, never commit a real key.
QDRANT_URL=https://<cluster-id>.cloud.qdrant.io:6333
QDRANT_API_KEY=replace-locally
QDRANT_COLLECTION=librarian-chunks
# QDRANT_PREFER_GRPC=true
