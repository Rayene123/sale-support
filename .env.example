DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@[POOLER-HOST]:5432/postgres?sslmode=require
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_TIMEOUT=120

# Sentiment benchmark: choose provider presets and model IDs.
PROVIDERS=ollama
# OPENAI_MODEL=your-model-id
# OPENAI_API_KEY=replace-locally
# GROQ_MODEL=openai/gpt-oss-20b
# GROQ_API_KEY=replace-locally
# COMPATIBLE_MODEL=your-served-model
# COMPATIBLE_BASE_URL=http://localhost:1234/v1
# For authenticated compatible APIs use --api-key-env MY_API_KEY.
# MY_API_KEY=replace-locally

# Project 2: local generation remains the default. Set OS variables first,
# otherwise project 2/.env takes precedence over the repository .env.
# GENERATION_PROVIDER=ollama
# OLLAMA_MODEL=qwen3.5:9b
# To use OpenAI generation, set GENERATION_PROVIDER=openai, provide
# OPENAI_API_KEY, and choose OPENAI_MODEL (for example, gpt-6-luna).
# OPENAI_MODEL=gpt-6-luna
# OPENAI_SERVICE_TIER=default
# GENERATION_CONTEXT_CHARS=12000
# RETRIEVAL_BACKEND=local
# QUESTION_REWRITING=true
# CALIBRATION_FILE=/absolute/path/to/backend-matched-calibration.json
# ALLOW_PAID_CALLS=false
# OpenAI Responses: set these in project 2/.env to switch from Ollama.
# GENERATION_PROVIDER=openai
# OPENAI_MODEL=gpt-6-luna
# OPENAI_REASONING_EFFORT=none
# OPENAI_API_KEY=replace-locally
# ALLOW_PAID_CALLS=false
# OPENAI_BUDGET_FILE=/persistent/path/budget.sqlite
# OPENAI_BUDGET_USD=choose-an-explicit-run-limit
# DEMO_PASSWORD=choose-a-project-password

# Project 2: Qdrant vector index. Copy the cluster URL and API key from the
# Qdrant Cloud console (or use a local URL such as http://localhost:6333).
# QDRANT_API_KEY is a secret; .env is git-ignored, never commit a real key.
QDRANT_URL=https://<cluster-id>.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key
QDRANT_COLLECTION=librarian-chunks
# QDRANT_PREFER_GRPC=true
