# Local model configuration. Start Ollama and install the selected model first.
SPECIALIST_OLLAMA_URL=http://127.0.0.1:11434
SPECIALIST_OLLAMA_MODEL=ministral-3:8b
# Use Ollama for the original Shopline Ops web graph as well.
SPECIALIST_LEGACY_LLM=true

# Optional LangSmith tracing; implemented by Person 4.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=shopline-ops

# Dedicated sandbox only; configured by Person 2.
SUPABASE_URL=
SUPABASE_KEY=

# Person 1 graph safety bound.
MAX_STEPS=20
