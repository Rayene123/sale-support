# Local model configuration. Start Ollama and install the selected model first.
SPECIALIST_OLLAMA_URL=http://127.0.0.1:11434
SPECIALIST_OLLAMA_MODEL=ministral-3:8b
# Use Ollama for the original Shopline Ops web graph as well.
SPECIALIST_LEGACY_LLM=true

# Optional Phase 4 tracing. The local workbench works with tracing disabled.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=shopline-ops

# Dedicated sandbox only; configured by Person 2.
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SANDBOX_URL=

# Optional loopback workbench accounts. Omitted passcodes are generated at startup.
SPECIALIST_CUSTOMER_ID=C-001
SPECIALIST_REVIEWER_ID=R-001
# SPECIALIST_CUSTOMER_PASSWORD=
# SPECIALIST_ADMIN_PASSWORD=

# Person 1 graph safety bound.
MAX_STEPS=20
